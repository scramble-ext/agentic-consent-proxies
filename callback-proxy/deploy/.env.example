# ─────────────────────────────────────────────────────────────────────────────
# Consent Notification Proxy — customer environment template.
# Copy to `.env` and fill in. This file is NON-SECRET: it must contain no keys,
# tokens, or passwords. Secrets reach the container only as mounted files.
#
#   cp .env.example .env   &&   edit .env
# ─────────────────────────────────────────────────────────────────────────────

# --- Image (used by docker-compose.yml) ---
# Pin to the exact version ScrambleID provided (immutable tag or @sha256 digest).
CONSENT_PROXY_IMAGE=ghcr.io/scramble-ext/consent-proxy:REPLACE_WITH_VERSION

# --- Where health/metrics bind on the host ---
# Default loopback-only. Set to an approved internal interface IP to scrape remotely.
CONSENT_PROXY_BIND_IP=127.0.0.1
CONSENT_PROXY_HOST_PORT=8080

# --- Config file (path INSIDE the container; mounted from ./config) ---
CONFIG_PATH=/etc/consent-proxy/config/config.json

# --- Logging (production default) ---
LOG_LEVEL=info
# PRINT_OUTCOMES is intentionally unset in production. Set to 1 only for temporary
# debugging; it pretty-prints every received outcome to the logs.
# PRINT_OUTCOMES=1

# --- Callback authentication (token delivery to YOUR receiver) ---
# DEFAULT: callback auth is OFF. The shipped config.json has no callback.auth
# block (mechanism "none"), and CALLBACK_AUTH_ORIGIN is left UNSET below. In this
# state the proxy BOOTS and delivers UNAUTHENTICATED callbacks (no Authorization
# header). This is the safe default — the bundle starts cleanly out of the box.
#
# IMPORTANT: Do NOT set CALLBACK_AUTH_ORIGIN on its own. An origin set WITHOUT a
# configured mechanism FAILS STARTUP — the proxy never reuses its upstream
# ScrambleID token for callbacks. To enable authenticated callbacks you must
# configure BOTH a mechanism (in config.json under callback.auth, or via
# CALLBACK_AUTH_* below) AND this origin, AND mount the matching secret file.
# See docs/customer-deployment.md §13 for the full opt-in walkthrough.
#
# To enable authenticated callbacks (summary — see §13 for detail):
#   1) add a callback.auth block to config/config.json (mechanism + clientId +
#      tokenEndpoint or discoveryUrl + scope),
#   2) place the dedicated callback secret at secrets/callback-client-secret
#      (clientCredentials) or secrets/callback-private.pem (privateKeyJwt) and
#      uncomment its mount in docker-compose.yml + the *_FILE var below,
#   3) uncomment and set CALLBACK_AUTH_ORIGIN to YOUR receiver origin
#      (scheme://host[:port], no path/query/credentials).
# CALLBACK_AUTH_ORIGIN=https://your-receiver.internal

# --- Dedicated callback credential (OPTIONAL) ---
# By default (nothing set below, or CALLBACK_AUTH_MECHANISM=none) NO callback bearer
# is sent — the proxy NEVER reuses the upstream M2M token for callbacks. To
# authenticate deliveries, mint a DEDICATED callback token from a ScrambleID or
# your-own auth server by setting a mechanism and its fields (and CALLBACK_AUTH_ORIGIN
# above). Non-secret fields may also live in config.json (callback.auth.*); these env
# vars override them. Secrets are mounted as files only (never inline here).
#
# CALLBACK_AUTH_MECHANISM=none           # none | privateKeyJwt | clientCredentials
# CALLBACK_AUTH_TOKEN_ENDPOINT=https://auth.example.com/oauth2/token
# --- OIDC discovery (alternative to TOKEN_ENDPOINT, for EITHER mechanism) ---
# Set DISCOVERY_URL to let the proxy read the token endpoint from the auth server's
# .well-known document instead of configuring it by hand (HTTPS-only, SSRF-guarded,
# cached). If BOTH are set, the explicit CALLBACK_AUTH_TOKEN_ENDPOINT wins.
# CALLBACK_AUTH_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration
# CALLBACK_AUTH_JWKS_URI=https://auth.example.com/jwks   # optional, informational/override only
# CALLBACK_AUTH_ISSUER=https://auth.example.com   # privateKeyJwt assertion aud; defaults to discovered issuer, then token endpoint
# CALLBACK_AUTH_CLIENT_ID=your-callback-client-id
# CALLBACK_AUTH_SCOPE=callback.write
# CALLBACK_AUTH_AUDIENCE=https://your-receiver.internal   # optional token audience/resource
# CALLBACK_AUTH_SIGNING_ALG=RS256        # privateKeyJwt: RS256 | PS256
# CALLBACK_AUTH_KID=key-1                # privateKeyJwt: optional JWK kid
# CALLBACK_AUTH_ASSERTION_TTL_SECONDS=60 # privateKeyJwt: assertion lifetime (<=3600)
# CALLBACK_AUTH_CLIENT_AUTH_METHOD=client_secret_basic  # clientCredentials: client_secret_basic | client_secret_post
#
# Dedicated callback SECRETS (mounted files; see docker-compose.yml):
#   privateKeyJwt:
# CALLBACK_AUTH_PRIVATE_KEY_FILE=/run/consent-proxy-secrets/callback-private.pem
#   If that PEM is encrypted, also mount a passphrase file:
# CALLBACK_AUTH_PRIVATE_KEY_PASSPHRASE_FILE=/run/consent-proxy-secrets/callback-passphrase
#   clientCredentials:
# CALLBACK_AUTH_CLIENT_SECRET_FILE=/run/consent-proxy-secrets/callback-client-secret

# --- Upstream auth secret (private_key_jwt) ---
# Path INSIDE the container to your mounted private key (see docker-compose.yml mount).
# The non-secret auth settings (mode, token endpoint, issuer, client id) live in config.json.
AUTH_PRIVATE_KEY_FILE=/run/consent-proxy-secrets/private.pem
# If your PEM is encrypted, also mount a passphrase file and point to it:
# AUTH_PRIVATE_KEY_PASSPHRASE_FILE=/run/consent-proxy-secrets/passphrase

# --- Alternative upstream auth modes (uncomment ONE instead of privateKeyJwt) ---
# clientCredentials: set auth.mode=clientCredentials in config.json, then here:
#   AUTH_CLIENT_SECRET_FILE=/run/consent-proxy-secrets/client-secret
# static (pre-obtained bearer token): set auth.mode=static in config.json, then here:
#   UPSTREAM_TOKEN_FILE=/run/consent-proxy-secrets/upstream-token

# --- Enterprise egress (optional) ---
# HTTPS_PROXY=http://proxy.corp.internal:8080
# NO_PROXY=localhost,127.0.0.1
# NODE_EXTRA_CA_CERTS=/run/consent-proxy-secrets/corp-ca.pem
