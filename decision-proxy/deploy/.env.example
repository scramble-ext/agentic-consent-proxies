# Policy decision proxy settings. No secrets here: the private key is a file, mounted by
# docker-compose.yml from ./secrets/private.pem. Never put key text in this file.

# --- Container ---
DECISION_PROXY_IMAGE=ghcr.io/scramble-ext/policy-decision-proxy:<version>
# Internal IP your gateway reaches. Not 0.0.0.0.
DECISION_PROXY_BIND_IP=
DECISION_PROXY_HOST_PORT=8080

# --- Required ---
DECISION_PROXY_SERVER_URL=https://consent.scrambleid.com
# Where the decision proxy gets its own policy.sync token, e.g. https://<env>.scrambleid.com/oidc/<org>/token
DECISION_PROXY_TOKEN_URL=
# The M2M service account whose public key is registered at the issuer.
DECISION_PROXY_CLIENT_ID=
# Where the private key is inside the container (the mount in docker-compose.yml).
DECISION_PROXY_PRIVATE_KEY_FILE=/run/policy-decision-proxy-secrets/private.pem
# Key set that signs your gateway's policy.evaluate tokens.
DECISION_PROXY_JWKS_URL=

# --- Optional ---
# Encrypted key: path of its passphrase file (mount it, see docker-compose.yml).
# DECISION_PROXY_PRIVATE_KEY_PASSPHRASE_FILE=/run/policy-decision-proxy-secrets/passphrase
# RS256 (default) or PS256, and the key id registered at the issuer, if it has one.
# DECISION_PROXY_SIGNING_ALG=RS256
# DECISION_PROXY_KEY_ID=
# The issuer, as the audience of the signed assertion. Default: DECISION_PROXY_TOKEN_URL.
# DECISION_PROXY_TOKEN_ISSUER=https://<env>.scrambleid.com/oidc/<org>
# Comma-separated. Empty = any issuer of that key set.
DECISION_PROXY_ISSUERS=
DECISION_PROXY_AUDIENCE=
DECISION_PROXY_LOG_LEVEL=info
# DECISION_PROXY_MAX_STALENESS_SECONDS=30
# DECISION_PROXY_MAX_APPLY_LAG_SECONDS=5
# DECISION_PROXY_MAX_CLOCK_SKEW_MS=2000
# DECISION_PROXY_STREAM_IDLE_SECONDS=15
# A call right after a start waits this long for the first copy. Keep it under your gateway's
# target timeout. 0 = answer 503 at once.
# DECISION_PROXY_FIRST_LOAD_WAIT_MS=1500

# --- Corporate network (uncomment if needed) ---
# NODE_EXTRA_CA_CERTS=/run/policy-decision-proxy-secrets/corp-ca.pem
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.internal:3128
# NO_PROXY=localhost,127.0.0.1
